# ==============================================
# SkillTwin — Environment Configuration Template
# ==============================================

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Signs and verifies session JWTs. REQUIRED in production.
# backend/routers/auth.py falls back to a development default when this is
# unset -- that default is committed and public, so anyone who knows it can
# forge a session for any user. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=skilltwin_password
POSTGRES_DB=skilltwin_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://<username>:<password>@localhost:5432/skilltwin_db

# Frontend API Configuration
VITE_API_URL=http://localhost:8000

# LLM & Third-Party APIs - OpenRouter Configuration
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
# Alternative models:
#   google/gemini-2.0-flash-thinking-exp-01-21
#   openai/gpt-4o
#   meta-llama/llama-3-8b-instruct

GITHUB_TOKEN=
